generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum UserType {
  MEMBER
  STAFF
}

enum UserStatus {
  ACTIVE
  UNACTIVATED
  SUSPENDED
  CLOSED
  DELETED
}

enum MembershipTier {
  ESSENTIAL
  PROFESSIONAL
  MASTER
}

enum MembershipStatus {
  PENDING_PAYMENT
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum StaffRole {
  REVIEWER_OPERATOR
  FINANCE_OFFICER
  SYSTEM_ADMINISTRATOR
}

enum TokenPurpose {
  ACTIVATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum FileCategory {
  CV
  PROFILE_PHOTO
  SUPPORTING_DOC
}

enum FileStatus {
  QUARANTINED
  ACTIVE
  REJECTED_MALWARE
  SUPERSEDED
  ARCHIVED
}

enum AssessmentCredentialStatus {
  AVAILABLE
  ASSIGNED
  EXHAUSTED
}

// Models

model User {
  id                 String              @id @default(uuid())
  email              String
  emailNormalized    String              @unique
  passwordHash       String
  userType           UserType
  status             UserStatus          @default(ACTIVE)
  failedAttemptCount Int                 @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  member             Member?
  staff              Staff?
  sessions           Session[]
  verificationTokens VerificationToken[]
}

model Member {
  id                    String       @id @default(uuid())
  userId                String       @unique
  fullNameEn            String
  fullNameAr            String?
  phone                 String
  phoneNormalized       String       @unique
  country               String
  city                  String?
  yearsOfExperience     String
  areasOfExpertise      String[]
  industriesServed      String[]
  languages             String[]
  bioEn                 String?      @db.Text
  bioAr                 String?      @db.Text
  linkedinUrl           String?
  photoFileId           String?
  directoryOptIn        Boolean      @default(false)
  profileCompletionRate Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  memberships           Membership[]
  files                 File[]

  @@index([country, directoryOptIn, profileCompletionRate])
}

model Membership {
  id        String           @id @default(uuid())
  memberId  String
  tier      MembershipTier   @default(ESSENTIAL)
  status    MembershipStatus @default(ACTIVE)
  price     Decimal          @default(0.0) @db.Decimal(10, 2)
  startDate DateTime         @default(now())
  endDate   DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([memberId, status])
  @@index([endDate])
}

model Staff {
  id          String    @id @default(uuid())
  userId      String    @unique
  role        StaffRole
  grantedAt   DateTime  @default(now())
  grantedById String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  ipAddress      String
  userAgent      String
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastActivityAt, expiresAt])
}

model LoginAttempt {
  id              String   @id @default(uuid())
  email           String
  emailNormalized String
  ipAddress       String
  successful      Boolean
  attemptedAt     DateTime @default(now())

  @@index([email, attemptedAt])
  @@index([emailNormalized, attemptedAt])
  @@index([ipAddress, attemptedAt])
}

model TokenRequestLog {
  id         String       @id @default(uuid())
  purpose    TokenPurpose
  email      String       // normalized/lowercase
  ipAddress  String
  requestedAt DateTime    @default(now())

  @@index([email, purpose, requestedAt])
  @@index([ipAddress, purpose, requestedAt])
}

model VerificationToken {
  id            String       @id @default(uuid())
  userId        String
  purpose       TokenPurpose
  tokenHash     String       @unique
  expiresAt     DateTime
  usedAt        DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model File {
  id           String       @id @default(uuid())
  ownerId      String
  category     FileCategory
  originalName String
  storageKey   String       @unique
  mimeType     String
  sizeBytes    Int
  status       FileStatus   @default(QUARANTINED)
  scanResult   String?
  supersededAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  owner        Member       @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, category, status])
}

model AuditLog {
  id             String   @id @default(uuid())
  sequenceNumber BigInt   @unique @default(autoincrement())
  actorId        String?
  actorRole      String?
  action         String
  resource       String
  resourceId     String?
  previousState  Json?
  newState       Json?
  reason         String?
  ipAddress      String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([actorId, action])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model SecurityConfig {
  id                                   Int      @id @default(1)
  passwordMinLength                    Int      @default(8)
  lockoutThreshold                     Int      @default(5)
  lockoutWindowMinutes                 Int      @default(15)
  lockoutDurationMinutes               Int      @default(30)
  sessionTimeoutMinutes                Int      @default(30)
  resetTokenLifetimeMinutes            Int      @default(60)
  activationLinkLifetimeMinutes        Int      @default(10)
  tokenRequestMaxPerEmail              Int      @default(5)
  tokenRequestWindowMinutesPerEmail    Int      @default(60)
  tokenRequestMaxPerIp                 Int      @default(10)
  tokenRequestWindowMinutesPerIp       Int      @default(60)
  unactivatedRetentionMonths           Int      @default(12)
  unactivatedReminderDaysBeforeCutoff Int      @default(7)
  updatedAt                            DateTime @updatedAt
  updatedById                          String?
}

model AssessmentCredentialPool {
  id          String                     @id @default(cuid())
  username    String                     @unique
  password    String
  accessUrl   String?
  status      AssessmentCredentialStatus @default(AVAILABLE)
  assignedTo  String?
  assignedAt  DateTime?
  createdAt   DateTime                   @default(now())

  @@index([status])
}
