generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum UserType {
  MEMBER
  STAFF
}

enum UserStatus {
  ACTIVE
  UNACTIVATED
  SUSPENDED
  CLOSED
  DELETED
}

enum MembershipTier {
  ESSENTIAL
  PROFESSIONAL
  MASTER
}

enum MembershipStatus {
  PENDING_PAYMENT
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum StaffRole {
  REVIEWER_OPERATOR
  FINANCE_OFFICER
  SYSTEM_ADMINISTRATOR
}

enum TokenPurpose {
  ACTIVATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum FileCategory {
  CV
  PROFILE_PHOTO
  SUPPORTING_DOC
}

enum FileStatus {
  QUARANTINED
  ACTIVE
  REJECTED_MALWARE
  SUPERSEDED
  ARCHIVED
}

enum AssessmentCredentialStatus {
  AVAILABLE
  ASSIGNED
  EXHAUSTED
}

enum PricingModel {
  IN_HUB
  PERCENTAGE
  INCLUDED_OR_QUOTED
  QUOTED
  FIXED
  FREE_THEN_PAID
  NONE
}

enum CatalogItemCategory {
  CORE_SERVICE
  DIAGNOSTIC_TOOL
  BUSINESS_SIMULATION
  PROFESSIONAL_RECOGNITION
}

enum EngagementRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_RESPONSE
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  FULFILLED
  REJECTED
  CANCELLED
}

// Models

model User {
  id                 String              @id @default(uuid())
  email              String
  emailNormalized    String              @unique
  passwordHash       String
  userType           UserType
  status             UserStatus          @default(ACTIVE)
  failedAttemptCount Int                 @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  member             Member?
  staff              Staff?
  sessions           Session[]
  verificationTokens VerificationToken[]
  passwordHistory    PasswordHistory[]
  notifications      Notification[]
  transactions       Transaction[]

  @@index([status, createdAt])
}

model Member {
  id                    String       @id @default(uuid())
  userId                String       @unique
  fullNameEn            String
  fullNameAr            String?
  phone                 String
  phoneNormalized       String       @unique
  country               String
  city                  String?
  yearsOfExperience     String
  areasOfExpertise      String[]
  industriesServed      String[]
  languages             String[]
  bioEn                 String?      @db.Text
  bioAr                 String?      @db.Text
  linkedinUrl           String?
  photoFileId           String?
  directoryOptIn        Boolean      @default(false)
  profileCompletionRate Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  memberships           Membership[]
  files                 File[]
  engagementRequests    EngagementRequest[]

  @@index([country, directoryOptIn, profileCompletionRate])
  @@index([directoryOptIn])
  @@index([directoryOptIn, profileCompletionRate])
  @@index([directoryOptIn, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Membership {
  id        String           @id @default(uuid())
  memberId  String
  tier      MembershipTier   @default(ESSENTIAL)
  status    MembershipStatus @default(ACTIVE)
  price     Decimal          @default(0.0) @db.Decimal(10, 2)
  startDate DateTime         @default(now())
  endDate   DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([memberId, status])
  @@index([memberId, createdAt(sort: Desc)])
  @@index([endDate])
}

model Staff {
  id          String    @id @default(uuid())
  userId      String    @unique
  role        StaffRole
  grantedAt   DateTime  @default(now())
  grantedById String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  ipAddress      String
  userAgent      String
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastActivityAt, expiresAt])
}

model LoginAttempt {
  id              String   @id @default(uuid())
  email           String
  emailNormalized String
  ipAddress       String
  successful      Boolean
  attemptedAt     DateTime @default(now())

  @@index([email, attemptedAt])
  @@index([emailNormalized, attemptedAt])
  @@index([ipAddress, attemptedAt])
}

model TokenRequestLog {
  id         String       @id @default(uuid())
  purpose    TokenPurpose
  email      String       // normalized/lowercase
  ipAddress  String
  requestedAt DateTime    @default(now())

  @@index([email, purpose, requestedAt])
  @@index([ipAddress, purpose, requestedAt])
}

model VerificationToken {
  id            String       @id @default(uuid())
  userId        String
  purpose       TokenPurpose
  tokenHash     String       @unique
  expiresAt     DateTime
  usedAt        DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model File {
  id           String       @id @default(uuid())
  ownerId      String
  category     FileCategory
  originalName String
  storageKey   String       @unique
  mimeType     String
  sizeBytes    Int
  status       FileStatus   @default(QUARANTINED)
  scanResult   String?
  supersededAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  owner        Member       @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, category, status])
  @@index([ownerId, status])
}

model AuditLog {
  id             String   @id @default(uuid())
  sequenceNumber BigInt   @unique @default(autoincrement())
  actorId        String?
  actorRole      String?
  action         String
  resource       String
  resourceId     String?
  previousState  Json?
  newState       Json?
  reason         String?
  ipAddress      String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([actorId, action])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@index([action, resourceId])
  @@index([createdAt])
}

model SecurityConfig {
  id                                   Int      @id @default(1)
  passwordMinLength                    Int      @default(8)
  lockoutThreshold                     Int      @default(5)
  lockoutWindowMinutes                 Int      @default(15)
  lockoutDurationMinutes               Int      @default(30)
  sessionTimeoutMinutes                Int      @default(30)
  resetTokenLifetimeMinutes            Int      @default(60)
  activationLinkLifetimeMinutes        Int      @default(10)
  tokenRequestMaxPerEmail              Int      @default(5)
  tokenRequestWindowMinutesPerEmail    Int      @default(60)
  tokenRequestMaxPerIp                 Int      @default(10)
  tokenRequestWindowMinutesPerIp       Int      @default(60)
  unactivatedRetentionMonths           Int      @default(12)
  unactivatedReminderDaysBeforeCutoff Int      @default(7)
  singleLineFieldMaxLength            Int      @default(250)
  multiLineFieldMaxLength             Int      @default(5000)
  updatedAt                            DateTime @updatedAt
  updatedById                          String?
}

model AssessmentCredentialPool {
  id          String                     @id @default(cuid())
  username    String                     @unique
  password    String
  accessUrl   String?
  status      AssessmentCredentialStatus @default(AVAILABLE)
  assignedTo  String?
  assignedAt  DateTime?
  createdAt   DateTime                   @default(now())

  @@index([status])
}

model EmailLockout {
  emailNormalized    String    @id
  failedAttemptCount Int       @default(0)
  lockedUntil        DateTime?
  updatedAt          DateTime  @updatedAt
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model CatalogItem {
  id            String              @id @default(uuid())
  slug          String              @unique
  category      CatalogItemCategory
  pricingModel  PricingModel        @default(QUOTED)
  packageLevel  String?             // e.g. "LEVEL_1", "LEVEL_2", "LEVEL_3"
  nameEn        String
  nameAr        String?
  descriptionEn String?             @db.Text
  descriptionAr String?             @db.Text
  basePrice     Int                 @default(0) // Minor units (e.g. cents)
  currency      String              @default("USD")
  percentageRate Decimal?           @db.Decimal(5, 2) // e.g. 5.00 for percentage model
  isActive      Boolean             @default(true)
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  requests      EngagementRequest[]

  @@index([category, isActive])
  @@index([slug])
  @@index([pricingModel])
}

model EngagementRequest {
  id                        String                  @id @default(uuid())
  referenceCode             String                  @unique // REQ-YYYY-0nnn
  memberId                  String
  catalogItemId             String
  category                  CatalogItemCategory
  status                    EngagementRequestStatus @default(SUBMITTED)
  pricingModel              PricingModel            @default(QUOTED)

  // Snapshot at submission (SEC-33)
  tierAtRequest             MembershipTier
  membershipStatusAtRequest MembershipStatus
  standardPrice             Int?                    // Minor units (cents)
  percentageRate            Decimal?                @db.Decimal(5, 2)

  // Member Input / Brief
  brief                     Json?
  customRequirements        String?                 @db.Text
  intakeData                Json?
  acknowledgement           Boolean                 @default(false)

  // Approved Price Breakdown (Calculated upon admin approval)
  baseAmount                Int?                    // Project value for percentage or quoted base (in minor units / cents)
  basePrice                 Int?                    // standard price or 5% of baseAmount (in minor units / cents)
  discountPercentage        Decimal?                @db.Decimal(5, 2)
  discountAmount            Int?                    // in minor units / cents
  finalPrice                Int?                    // in minor units / cents
  currency                  String                  @default("USD")
  isQuarterlyEntitlement    Boolean                 @default(false)
  quarterIndex              Int?
  membershipYear            Int?

  // Payment Tracking
  paymentReference          String?
  paidAt                    DateTime?

  // Admin & Lifecycle Tracking
  adminNotes                String?                 @db.Text
  reviewNotes               String?                 @db.Text
  cancellationReason        String?                 @db.Text
  rejectionReason           String?                 @db.Text
  infoRequestedAt           DateTime?
  approvedAt                DateTime?
  fulfilledAt               DateTime?
  cancelledAt               DateTime?
  rejectedAt                DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  member                    Member                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  catalogItem               CatalogItem             @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([memberId, status])
  @@index([memberId, catalogItemId, status])
  @@index([memberId, createdAt(sort: Desc)])
  @@index([referenceCode])
  @@index([category, status])
  @@index([memberId, isQuarterlyEntitlement, quarterIndex, membershipYear], map: "EngagementRequest_entitlement_idx")
}

model RequestSequenceCounter {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  titleEn   String
  titleAr   String
  bodyEn    String   @db.Text
  bodyAr    String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  SIMULATED_GATEWAY
  CREDIT_CARD
  BANK_TRANSFER
  ADMIN_MANUAL
}

model Transaction {
  id               String            @id @default(uuid())
  invoiceNumber    String            @unique @map("invoice_number")
  userId           String            @map("user_id")
  sourceType       String            @map("source_type")
  sourceId         String            @map("source_id")
  amountCents      Int               @map("amount_cents")
  currency         String            @default("USD")
  status           TransactionStatus @default(PAID)
  paymentMethod    PaymentMethod     @default(ADMIN_MANUAL) @map("payment_method")
  paymentReference String            @unique @map("payment_reference")
  billingDetails   Json              @map("billing_details")
  paidAt           DateTime          @default(now()) @map("paid_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([sourceType, sourceId])
  @@map("transactions")
}

model InvoiceSequenceCounter {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("invoice_sequence_counter")
}
