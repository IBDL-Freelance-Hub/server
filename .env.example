# Environment Template — IBDL Freelancers Hub Backend

# Application Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# Security & CORS
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=ibdl_freelancers_hub_default_secret_key_32chars_min

# PostgreSQL Database (Local / Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ibdl_freelancers_hub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ibdl_freelancers_hub?schema=public&connection_limit=25&pool_timeout=20

# SMTP Mail Server (Email Services)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=freelancer-hub@ibdl.net
SMTP_PASS=your_smtp_password
EMAIL_FROM="Freelancers Hub" <freelancer-hub@ibdl.net>

# Cloudflare R2 Object Storage (PDFs / Assets)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=freelancers-hub
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
