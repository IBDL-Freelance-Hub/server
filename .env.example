# Environment Template — IBDL Freelancers Hub Backend

# Application Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# Security & CORS
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Local / Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ibdl_freelancers_hub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ibdl_freelancers_hub?schema=public
