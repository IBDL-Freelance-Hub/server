{
  "name": "ibdl-freelancers-hub-server",
  "version": "1.0.0",
  "description": "Backend API server for IBDL Freelancers Hub — Modular Monolith",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:nodemon": "nodemon --watch src -e ts --exec tsx src/server.ts",
    "build": "prisma generate && tsc && node -e \"fs.writeFileSync('dist/server.js', 'require(\\\"./src/server\\\");\\n')\"",
    "vercel-build": "prisma generate && tsc && node -e \"fs.writeFileSync('dist/server.js', 'require(\\\"./src/server\\\");\\n')\"",
    "prestart": "npm run build",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "r2:check": "tsx scripts/list-r2.ts",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "keywords": [
    "express",
    "typescript",
    "postgresql",
    "prisma",
    "modular-monolith"
  ],
  "author": "IBDL Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "resend": "^6.27.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^15.4.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.5.2",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  }
}
